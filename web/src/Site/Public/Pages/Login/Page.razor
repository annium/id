@namespace Site.Public.Pages.Login

@page "/login"
@layout MinimalCentricLayout
@using Annium.Blazor.Core
@using Annium.Localization.Abstractions
@using Site.Public.Layouts.MinimalCentric
@using Site.Shared.Components.PageTitle
@inherits BaseComponent

@inject IStore Store
@inject Style Style
@inject NavigationManager Router
@inject ILocalizer<Page> T

<PageTitle Class="@Style.Title" Level="2">
    Annium ID @T["Sign in"]
</PageTitle>

<div class="@Style.Form">
    <FormField TValue="string" State="@Store.Form.AtAtomic(x => x.Login)" Class="@Style.FormItem">
        <TextField
            TValue="string"
            Size="@InputSize.Large"
            Placeholder="@T["Login"]" />
    </FormField>

    <FormField TValue="string" State="@Store.Form.AtAtomic(x => x.Password)" Class="@Style.FormItem">
        <TextField
            TValue="string"
            Size="@InputSize.Large"
            Placeholder="@T["Password"]" />
    </FormField>

    <Button
        type="@ButtonType.Primary"
        block
        disabled="@(!Store.CanLogin)"
        size="@ButtonSize.Large"
        OnClick="@Store.LogInAsync">
        @T["Sign in"]
    </Button>

    <div class="@Style.Links">
        <div>
            <NavLink href="@Routes.RestoreAccess">@T["Forgot password?"]</NavLink>
        </div>
        <div>
            @T["No account?"] <NavLink href="@Routes.Register">@T["Sign Up"]</NavLink>
        </div>
    </div>
</div>