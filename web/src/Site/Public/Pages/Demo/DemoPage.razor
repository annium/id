@namespace Site.Public.Pages.Demo

@page "/demo"
@layout MinimalCentricLayout
@using Annium.Blazor.Core
@using Annium.Components.State.Forms
@using Annium.Extensions.Validation
@using Annium.Serialization.Abstractions
@using Site.Public.Layouts.MinimalCentric
@inherits BaseComponent

@inject IStateFactory StateFactory
@inject ISerializer<string> Serializer
@inject IValidator<Blog> Validator

Name:
<FormField TValue="string" State="@_state.AtAtomic(x => x.Name)">
    <TextField TValue="string" />
</FormField>
<CheckboxField State="@_state.AtArray(x => x.Messages).AtObject(x => x[0]).AtAtomic(x => x.IsRead)">
    is message read?
</CheckboxField>

@(Serializer.Serialize(_state.Value))