<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>Annium.Id.Api.IntegrationTests</PackageId>
        <PackageVersion>0.1.0</PackageVersion>
        <Description>Annium.Id.IntegrationTests</Description>
        <TargetFramework>net6.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <DebugType>portable</DebugType>
        <LangVersion>10.0</LangVersion>
        <WarningsAsErrors>true</WarningsAsErrors>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../../src/api/Annium.Id.Api/Annium.Id.Api.csproj" />
        <ProjectReference Include="../Annium.Id.Api.TestClient/Annium.Id.Api.TestClient.csproj" />
        <ProjectReference Include="../Annium.Id.Demo/Annium.Id.Demo.csproj" />
        <ProjectReference Include="../Annium.Id.Demo.TestClient/Annium.Id.Demo.TestClient.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Annium.AspNetCore.IntegrationTesting" Version="0.1.0" />
        <PackageReference Include="Annium.Testing.Assertions" Version="0.1.0" />
        <PackageReference Include="coverlet.collector" Version="3.1.2" />
        <PackageReference Include="coverlet.msbuild" Version="3.1.2" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="6.0.6" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.2.0" />
        <PackageReference Include="xunit" Version="2.4.1" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5" />
    </ItemGroup>
    <ItemGroup>
        <None Update="keys/*.key" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>