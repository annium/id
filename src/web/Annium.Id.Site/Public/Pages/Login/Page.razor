@using Annium.Localization.Abstractions
@using Annium.Id.Site.Public.Layouts

@namespace Annium.Id.Site.Public.Pages.Login

@page "/login"
@layout MinimalCentricLayout

@inject Store Store
@inject Styles Style
@inject NavigationManager Router
@inject ILocalizer<Page> Loc

<PageTitle Class="@Style.Title" Level="2">
    Annium ID @Loc["Sign in"]
</PageTitle>

<FormField TValue="string" state="@State.At(x => x.Login)">
    <TextField TValue="string" Placeholder="@Loc["Login"]" />
</FormField>

<FormField TValue="string" state="@State.At(x => x.Password)">
    <TextField TValue="string" Placeholder="@Loc["Password"]" />
</FormField>

<NavLink href="@Routes.Register">Register</NavLink>