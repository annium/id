@page "/home"
@using Annium.Id.Site.Public.Components
@using Annium.Serialization.Abstractions
@inject IStateFactory StateFactory
@inject ISerializer<string> Serializer

<TextInput state="@AuthorName" />

@(Serializer.Serialize(State.Value))

@code
{
    private IAtomicContainer<string> AuthorName => State.At(x => x.Author).At(x => x.Name);
    private IObjectContainer<Blog> State { get; set; } = default!;

    protected override void OnInitialized()
    {
        State = StateFactory.Create(new Blog());
    }
}