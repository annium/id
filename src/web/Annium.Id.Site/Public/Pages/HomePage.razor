@page "/home"
@using Annium.Id.Site.Public.Components
@using Annium.Serialization.Abstractions
@using Annium.Blazor.Core.Extensions
@inject IStateFactory StateFactory
@inject ISerializer<string> Serializer

<TextInput state="@_state.At(x => x.Author).At(x => x.Name)" />

@(Serializer.Serialize(_state.Value))

@code
{
    private IObjectContainer<Blog> _state = default!;

    protected override void OnInitialized()
    {
        _state = StateFactory.Create(new Blog());
        this.ObserveState();
    }
}¡