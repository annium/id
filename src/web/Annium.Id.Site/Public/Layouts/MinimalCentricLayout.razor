@namespace Annium.Id.Site.Public.Layouts

@inherits LayoutComponentBase

@inject Styles Styles;

<Layout>
    <Content>
        <Row>
            <Col Xs="@_xs" Sm="@_sm" Md="@_md" Lg="@_lg" Xl="@_xl" Xxl="@_xxl">
                <div class="@Styles.Container">
                    <Logo Class="@Styles.Logo" />
                    @Body
                    <div class="@Styles.Credentials">
                        Built with love by the <a className="@Styles.Link" href="https://annium.com/"> Annium</a> team.
                    </div>
                </div>
            </Col>
        </Row>
    </Content>
</Layout>