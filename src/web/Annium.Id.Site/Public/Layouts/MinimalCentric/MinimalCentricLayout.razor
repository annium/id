@namespace Annium.Id.Site.Public.Layouts.MinimalCentric

@inherits LayoutComponentBase

@inject Style Style;

<Layout>
    <Content>
        <Row>
            <Col Xs="@_xs" Sm="@_sm" Md="@_md" Lg="@_lg" Xl="@_xl" Xxl="@_xxl">
                <div class="@Style.Container">
                    <Logo Class="@Style.Logo" />
                    @Body
                </div>
                <div class="@Style.Credentials">
                    Built with love by the <a class="@Style.Link" href="https://annium.com/"> Annium</a> team.
                </div>
            </Col>
        </Row>
    </Content>
</Layout>