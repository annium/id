<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>Annium.Id.Api</PackageId>
        <PackageVersion>0.1.0</PackageVersion>
        <Description>Annium id entrypoint</Description>
        <TargetFramework>netcoreapp2.2</TargetFramework>
        <OutputType>Exe</OutputType>
        <DebugType>portable</DebugType>
        <LangVersion>latest</LangVersion>
        <WarningsAsErrors>true</WarningsAsErrors>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Annium.Id.Apps.AspNetCore/Annium.Id.Apps.AspNetCore.csproj" />
        <ProjectReference Include="../Annium.Id.AspNetCore/Annium.Id.AspNetCore.csproj" />
        <ProjectReference Include="../Annium.Id.ViewModels/Annium.Id.ViewModels.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Annium.Architecture.Http" Version="0.1.0" />
        <PackageReference Include="Annium.Architecture.Mediator" Version="0.1.0" />
        <PackageReference Include="Annium.AspNetCore.Extensions" Version="0.1.0" />
        <PackageReference Include="Microsoft.AspNetCore.Server.Kestrel" Version="2.2.0" />
        <PackageReference Include="Microsoft.AspNetCore.StaticFiles" Version="2.2.0" />
        <PackageReference Include="NodaTime.Serialization.JsonNet" Version="2.2.0" />
        <PackageReference Include="NSwag.AspNetCore" Version="13.0.4" />
    </ItemGroup>
    <ItemGroup>
        <None Update="**/locale/*.yml" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>