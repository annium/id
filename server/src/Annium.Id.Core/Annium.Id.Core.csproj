<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>Annium.Id.Core</PackageId>
        <PackageVersion>0.1.0</PackageVersion>
        <Description>Annium.Id.Core</Description>
        <TargetFramework>netcoreapp3.1</TargetFramework>
        <OutputType>Library</OutputType>
        <DebugType>portable</DebugType>
        <LangVersion>latest</LangVersion>
        <WarningsAsErrors>true</WarningsAsErrors>
        <IsPackable>true</IsPackable>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Annium.Data.Operations" Version="0.1.0" />
        <PackageReference Include="Annium.Logging.Abstractions" Version="0.1.0" />
        <PackageReference Include="Annium.Security.Cryptography" Version="0.1.0" />
        <PackageReference Include="MessagePack" Version="2.1.80" />
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="5.6.0" />
    </ItemGroup>
</Project>