<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>Server.Application</PackageId>
        <PackageVersion>0.1.0</PackageVersion>
        <Description>Server.Application</Description>
        <TargetFramework>net7.0</TargetFramework>
        <OutputType>Library</OutputType>
        <DebugType>portable</DebugType>
        <LangVersion>11.0</LangVersion>
        <WarningsAsErrors>true</WarningsAsErrors>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Server.Db/Server.Db.csproj" />
        <ProjectReference Include="../Server.Domain/Server.Domain.csproj" />
        <ProjectReference Include="../Server.Email/Server.Email.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Annium.Architecture.Mediator" Version="0.1.0" />
        <PackageReference Include="Annium.Core.Runtime" Version="0.1.0" />
        <PackageReference Include="Annium.Diagnostics.Debug" Version="0.1.0" />
        <PackageReference Include="Annium.Extensions.Validation" Version="0.1.0" />
        <PackageReference Include="Annium.Localization.Yaml" Version="0.1.0" />
    </ItemGroup>
    <ItemGroup>
        <None Update="**/locale/*.yml" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>