<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>Annium.Id.Infrastructure</PackageId>
        <PackageVersion>0.1.0</PackageVersion>
        <Description>Annium.Id.Infrastructure</Description>
        <TargetFramework>netcoreapp3.0</TargetFramework>
        <OutputType>Library</OutputType>
        <DebugType>portable</DebugType>
        <LangVersion>latest</LangVersion>
        <WarningsAsErrors>true</WarningsAsErrors>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Annium.Id.Domain/Annium.Id.Domain.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Annium.Configuration.Yaml" Version="0.1.0" />
        <PackageReference Include="Annium.Net.Mail" Version="0.1.0" />
    </ItemGroup>
    <ItemGroup>
        <None Update="Email/Templates/*.html" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>