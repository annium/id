<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>Server.IntegrationTests</PackageId>
        <PackageVersion>0.1.0</PackageVersion>
        <Description>Server.IntegrationTests</Description>
        <TargetFramework>net8.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <DebugType>portable</DebugType>
        <LangVersion>11.0</LangVersion>
        <WarningsAsErrors>true</WarningsAsErrors>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Server.DemoHost.TestClient/Server.DemoHost.TestClient.csproj" />
        <ProjectReference Include="../Server.Host.TestClient/Server.Host.TestClient.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Annium.AspNetCore.IntegrationTesting" Version="0.1.0" />
        <PackageReference Include="coverlet.collector" Version="6.0.0" />
        <PackageReference Include="coverlet.msbuild" Version="6.0.0" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
        <PackageReference Include="Testcontainers.PostgreSql" Version="3.6.0" />
        <PackageReference Include="xunit" Version="2.6.1" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    </ItemGroup>
    <ItemGroup>
        <None Update="keys/*.key" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>