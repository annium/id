<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>Annium.Id.Api.IntegrationTests</PackageId>
        <PackageVersion>0.1.0</PackageVersion>
        <Description>Annium id api integration tests</Description>
        <TargetFramework>netcoreapp2.2</TargetFramework>
        <OutputType>Exe</OutputType>
        <DebugType>portable</DebugType>
        <WarningsAsErrors>true</WarningsAsErrors>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>
    <ItemGroup>
        <None Update="keys/*.key" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/Annium.Id.Api/Annium.Id.Api.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Annium.AspNetCore.IntegrationTesting" Version="0.1.0" />
        <PackageReference Include="Annium.Testing.TestAdapter" Version="0.1.0" />
        <PackageReference Include="coverlet.msbuild" Version="2.6.2" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="2.2.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="2.2.4" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="16.1.1" />
    </ItemGroup>
</Project>